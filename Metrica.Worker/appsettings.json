{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Metrica.Worker"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/metrica-worker-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "SeaweedFs": {
    "BaseUrl": "http://localhost:8888",
    "Directory": "metrica/uploads"
  },
  "FileLoadNotifications": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 30
  },
  "FileProcessingOutbox": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 5
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=MetricaDb;User Id=sa;Password=MetricaSql2026!;TrustServerCertificate=True;Encrypt=False"
  }
}
