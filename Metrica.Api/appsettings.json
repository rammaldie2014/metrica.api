{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Metrica.Api"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/metrica-api-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "SeaweedFs": {
    "BaseUrl": "http://localhost:8888",
    "Directory": "metrica/uploads"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=MetricaDb;User Id=sa;Password=MetricaSql2026!;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "Metrica.Authentication",
    "Audience": "Metrica.Api"
  },
  "AllowedHosts": "*"
}
